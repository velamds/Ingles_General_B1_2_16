ttempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "id": 10, "template_override": 1, "type": "RSLT", "questions": [{"responses": [{"id": 0, "selected": 0, "correct": 0, "_data": [{"content": "", "type": "text"}]}, {"id": 1, "selected": 0, "correct": 1, "_data": [{"content": "", "type": "text"}]}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}]}]}, {"stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Write what you would do if you could be the president!"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}], "id": 11, "template_override": 1, "type": "DWS", "questions": [{"responses": [{"id": 0, "selected": 0, "correct": 1, "_data": [{"content": "", "type": "text"}]}], "id": 0, "_data": [{"type": "question", "contents": [{"content": "engenn7le16ob09re7pdf01.pdf", "type": "pdf"}]}]}]}], "stimuli": [{"id": 0, "template_override": 1, "type": "welcome", "contents": [{}], "_data": []}, {"_data": [], "id": 1, "template_override": 1, "type": "audio", "title": "", "contents": [{"value": {"images": [{"id": 0, "image": "engenn7le16ob09re2img01.jpg", "text": "", "time": "0"}, {"id": 1, "image": "engenn7le16ob09re2img01.jpg", "text": "<span class=\"strong\">Sally</span>:         Hello?<br/><span class=\"strong\">Vanessa</span>:     Hey, Sal. I'm coming over. I just left the club.<br/><span class=\"strong\">Sally</span>:         Ok! <br/><span class=\"strong\">Sally</span>:         So, how was Shimmer? Do you wish you stayed longer?<br/><span class=\"strong\">Vanessa</span>:     It was good! There were a lot of people and Peter was lots of fun! The DJ was great, too. He spun some awesome tracks. I wish I wore more comfortable shoes, though. My feet are killing me!", "time": "100"}, {"id": 2, "image": "engenn7le16ob09re2img05.jpg", "text": "<span class=\"strong\">Sally</span>:         If I were you, I would carry a spare pair ... you know those foldable flats they sell now? <br/><span class=\"strong\">Vanessa</span>:     My legs are aching, too.<br/><span class=\"strong\">Sally</span>:         If you exercised more, you wouldn't feel so broken right now.<br/><span class=\"strong\">Vanessa</span>:     Well, if I had a private gym, like you, I would be able to! I need a coffee ...<br/><span class=\"strong\">Sally</span>:         Coming right up!", "time": "27000"}, {"id": 3, "image": "engenn7le16ob09re2img05.jpg", "text": "<span class=\"strong\">Vanessa</span>:     Thanks, Sal. You're the best. I wish I talked to more people there. I wish I weren't so shy ...<br/><span class=\"strong\">Sally</span>:         Yeah, you need to get back in the game. Marco kind of killed the whole dating thing for you. <br/><span class=\"strong\">Vanessa</span>:     Don't say that name aloud!<br/><span class=\"strong\">Sally</span>:         If I were you, I'd be out there more!<br/><span class=\"strong\">Vanessa</span>:    What are you talking about? You don't have a boyfriend, either!", "time": "46000"}], "coverimg": "engenn7le16ob09re2img01.jpg", "audiosrc": "engenn7le16ob09re2aud01"}, "type": "slideshow"}]}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "A Day With Vanessa", "type": "lesson_name"}, {"content": "I Wish I Had", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 16, "type": "lesson"}, {"content": "B1.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Use expressions about relationships and feelings in a range of social and work contexts. ", "type": "primary"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_1"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_2"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_3"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_4"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_5"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_6"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_7"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Second Conditional - Talking About Hypothetical Situations"}, {"type": "describer", "content": " You use the second conditional to talk about unreal or imaginary (hypothetical) situations in the present or future."}, {"type": "text", "content": "For example: <br/><span class=\"italic\">If I had a million dollars, I would buy a car.</span>"}, {"type": "text", "content": "Do you have a million dollars?  No.<br/>Is it possible to suddenly get a million dollars? Not really.<br/>What would you do if you had a million dollars? Buy a car."}, {"type": "text", "content": "You use the Simple Past verb + would/could"}, {"type": "table", "content": "{\"rows\":5,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"IF\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Conditional\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Result\\\"}\",\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"past\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"would + base verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"If\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I married Peter,\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I would be happy.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"If\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I exercised more,\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I could be in better shape.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"If\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I were you,\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" I would be jumping up and down.\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "text", "content": "You can also reverse the clauses:"}, {"type": "text", "content": "<span class=\"italic\">I would be out more if I were you.</span>"}, {"type": "text", "content": "Notice that there is no comma when the result clause comes first."}, {"type": "text", "content": "Remember to use a comma (,) after the IF clause. "}, {"type": "text", "content": "In conversation, it is common to use contractions. (I would = I'd)."}, {"type": "example", "content": "If I were you, I would carry a spare pair of shoes."}, {"type": "example", "content": "If you exercised more, you wouldn't feel so broken right now."}, {"type": "example", "content": "If I were you, I'd be out there more! "}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Talking about Wishes and Imaginary Situations"}, {"type": "describer", "content": "You use <span class=\"strong\">wish</span> and the second conditional to talk about things you want or would like to be different now or in the future."}, {"type": "text", "content": "Wishes and sentences in the second conditional infer that what you want is probably not possible, or for some reason impossible."}, {"type": "table", "content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Statement</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Meaning</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I wish it were all that easy!</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's not that easy\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I wish I could just go back for a few days and enjoy it all again.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I can't go back\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I wish I were young again!</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I am not young anymore.\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "example", "content": "I wish I wore more comfortable shoes, though. "}, {"type": "example", "content": "I wish I talked to more people there. "}, {"type": "example", "content": "I wish I weren't so shy ..."}]}, {"type": "target_word", "contents": [{"content": "foldable", "type": "name"}, {"content": "able to fold ", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: You know those foldable shoes they sell now? ", "type": "example"}, {"content": "engenn7le16ob09aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about social activities.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "flats", "type": "name"}, {"content": "a pair of flat shoes (similar to ballet shoes) worn by women", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Do you know those foldable flats they sell now? ", "type": "example"}, {"content": "engenn7le16ob09aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to spin", "type": "name"}, {"content": "to play a record", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: The DJ spun my favorite songs.", "type": "example"}, {"content": "engenn7le16ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "coming right up!", "type": "name"}, {"content": "You will have it soon.", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Your coffee is coming right up!", "type": "example"}, {"content": "engenn7le16ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to get back in the game", "type": "name"}, {"content": "to start dating again ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: You need to get back in the game.", "type": "example"}, {"content": "engenn7le16ob09aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to kill", "type": "name"}, {"content": "to ruin (casual language)", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Marco kind of killed the whole dating thing for you. ", "type": "example"}, {"content": "engenn7le16ob09aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "track", "type": "name"}, {"content": "song", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He spun some awesome tracks.", "type": "example"}, {"content": "engenn7le16ob09aud07", "type": "audio"}]}, {"content": "engenn7le16ob09re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Imagine that you want to be the president of your school or country, or the mayor of your city."}, {"type": "text", "content": "What would you do if people voted for you? Write sentences."}, {"type": "text", "content": "In a group, share your ideas and listen to your partners'  ideas."}, {"type": "text", "content": "Have a mini-election. Who would you vote for?"}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk about social activities."}, {"type": "text", "content": "I talk about wishes and imaginary situations."}, {"type": "text", "content": "I talk about hypothetical situations."}]}]}
type": "RSLT", "template_override": 1}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn7le16ob06re7pdf01.pdf", "type": "pdf"}]}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " What makes a great boss?", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn7le16ob06re2img01.jpg"}, {"text": "<span class=\"strong\">Sally</span>:         This is the perfect picnic spot! <br/><span class=\"strong\">Vanessa</span>:     Yeah, there's a great view of the park which I love. Wait, isn't that your boss, Ms. Ryan, over there?<br/><span class=\"strong\">Sally</span>:         Where? <br/><span class=\"strong\">Vanessa</span>:     The woman who is riding the bike.<br/><span class=\"strong\">Sally</span>:         Next to the guy that's sitting on the bench?<br/><span class=\"strong\">Vanessa</span>:     Yeah, she's just passing him now.", "id": 1, "time": "100", "image": "engenn7le16ob06re2img01.jpg"}, {"text": "<span class=\"strong\">Sally</span>:         If she comes near here, I'm going to freak out! <br/><span class=\"strong\">Vanessa</span>:     You must be terrified of her!<br/><span class=\"strong\">Sally</span>:         I'm not terrified ... I can't hack seeing her right now.<br/><span class=\"strong\">Vanessa</span>:     She must be a tough boss, then.<br/><span class=\"strong\">Sally</span>:         No tougher than you, I'm sure!", "id": 2, "time": "17500", "image": "engenn7le16ob06re2img05.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>:     When you see her at work, are you going to say you saw her?<br/><span class=\"strong\">Sally</span>:         No - before I get into the office, I'm going to text the guy who I work with, and ask him if the coast is clear. After he gives me the all clear, then I'll head to my desk.<br/>", "id": 3, "time": "32000", "image": "engenn7le16ob06re2img05.jpg"}, {"text": "<span class=\"strong\">Vanessa</span>:     Wow. Do you think my employees think that way about me?<br/><span class=\"strong\">Sally</span>:         I wouldn't be surprised. People respect you, which is important. Sometimes with respect comes a little fear ...<br/><span class=\"strong\">Vanessa</span>:     I don't want to be a terror! That's got to be dreadful for the staff.", "id": 4, "time": "46500", "image": "engenn7le16ob06re2img01.jpg"}], "audiosrc": "engenn7le16ob06re2aud01", "coverimg": "engenn7le16ob06re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}
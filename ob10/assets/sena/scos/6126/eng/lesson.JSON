{"_data": [{"contents": [{"content": "A Day With Vanessa", "type": "lesson_name"}, {"content": "That's What I Thought", "type": "unit_name"}, {"content": 10, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 16, "type": "lesson"}, {"content": "B1.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Use expressions about relationships and feelings in a range of social and work contexts. ", "type": "primary"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_1"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_2"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_3"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_4"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_5"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_6"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_7"}, {"content": "Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "Using <span class=\"italic\">If</span>, <span class=\"italic\">When</span>, <span class=\"italic\">Before</span> and <span class=\"italic\">After</span> to Talk About the Future", "type": "heading"}, {"content": "You use time clauses to give information about time and sequence.", "type": "describer"}, {"content": "You use the words <span class=\"italic\">If</span>, <span class=\"italic\">When</span>, <span class=\"italic\">Before</span> and <span class=\"italic\">After</span> in time clauses.", "type": "text"}, {"content": "You use the first conditional with these time clauses.", "type": "text"}, {"content": "<span class=\"italic\">If/When/Before/After</span> + Subject + Simple Present tense, Subject + <span class=\"italic\">will/be going to</span> + Simple Present tense", "type": "text"}, {"content": "<span class=\"strong\">Before</span> means at an earlier time.", "type": "text"}, {"content": "<span class=\"strong\">After</span> means at a later time.", "type": "text"}, {"content": "<span class=\"italic\">Before I go to sleep, I'll set my alarm.<br/>After I set my alarm, I'm going to go to sleep.</span>", "type": "text"}, {"content": "<span class=\"strong\">If</span> means on the condition that ...", "type": "text"}, {"content": "<span class=\"italic\">If I go to sleep, I'll set my alarm. (I'm not sure that I'll go to sleep.)</span>", "type": "text"}, {"content": "<span class=\"strong\">When</span> means at the time of doing something.", "type": "text"}, {"content": "<span class=\"italic\">When I go to bed, I'll set my alarm.</span>", "type": "text"}, {"content": "Before I do, I'm going to do some research.", "type": "example"}, {"content": "Before you blog about it, I'll send you pictures.", "type": "example"}, {"content": "If he asks you again, are you going to go?", "type": "example"}, {"content": "When I get the pictures, I'll call you if I have any questions.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "Asking for Clarification", "type": "heading"}, {"content": "You ask for clarification when you want more details on what the other person is talking about. ", "type": "describer"}, {"content": "You ask for clarification when it is not clear what the other person is referring to. You ask the other person to be more specific by giving you more information. ", "type": "text"}, {"content": "Questions within sentences are called <span class=\"strong\">embedded questions</span>. <br/>An embedded question is a question included in another question or statement.", "type": "text"}, {"content": "<span class=\"italic\">Example: </span><br/><span class=\"strong\">Simple question</span>: <span class=\"italic\">What are you going to do after dinner?</span><br/><span class=\"strong\">Embedded question</span>: <span class=\"italic\">Do you know what you're going to do after dinner?</span>", "type": "text"}, {"content": "Embedded questions are usually used to make your question or comment sound softer or more polite.", "type": "text"}, {"content": "Could you tell me what you mean by that?", "type": "example"}, {"content": "Can you remind me where the club is?", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "for the most part", "type": "name"}, {"content": "in most cases; usually", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: They were well-dressed, for the most part.", "type": "example"}, {"content": "engenn7le16ob10aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use to talk about feelings and reactions.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "to unwind", "type": "name"}, {"content": "to relax", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I think his job is stressing him out ... He needs nights like these to unwind.", "type": "example"}, {"content": "engenn7le16ob10aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "disco ball", "type": "name"}, {"content": "a round, shiny ball used in nightclubs to reflect lights", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: One thing I really liked about Shimmer is that they have a huge disco ball.", "type": "example"}, {"content": "engenn7le16ob10aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "laser show", "type": "name"}, {"content": "a light show using lasers", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: They had a laser show at the club!", "type": "example"}, {"content": "engenn7le16ob10aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "bar", "type": "name"}, {"content": "a part of a restaurant or club that sells drinks", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Let's just say the bar made great money!", "type": "example"}, {"content": "engenn7le16ob10aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "go-go dancer", "type": "name"}, {"content": "a dancer who entertains crowds at nightclubs", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There were also go-go dancers upstairs! ", "type": "example"}, {"content": "engenn7le16ob10aud06", "type": "audio"}], "type": "target_word"}, {"content": "engenn7le16ob10re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Think about what kind of dance club you like.", "type": "text"}, {"content": "If you owned a dance club, what would it have in it?", "type": "text"}, {"content": "Write down all the things that you want to put in a dance club.", "type": "text"}, {"content": "With a partner, design a dance club and create a poster advertisement for it.", "type": "text"}, {"content": "Show your poster to other students and tell them why they should come to your club.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I talk about feelings and impressions.", "type": "text"}, {"content": "I talk about connected events in the future. ", "type": "text"}, {"content": "I ask for clarification.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn7le16ob10re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn7le16ob10re2img05.jpg", "time": "100", "id": 1, "text": "<span class=\"strong\">Sally</span>:         Here's your coffee. What were the people at Shimmer like?<br/><span class=\"strong\">Vanessa</span>:     They all seemed really cool. They were well-dressed, for the most part. There were a few who seemed a little too excited ... if you know what I mean.<br/><span class=\"strong\">Sally</span>:         Uh, could you tell me what you mean by that? <br/><span class=\"strong\">Vanessa</span>:     Let's just say the bar made great money!"}, {"image": "engenn7le16ob10re2img05.jpg", "time": "21000", "id": 2, "text": "<span class=\"strong\">Sally</span>:         What about Peter? How was he?\n<br/><span class=\"strong\">Vanessa</span>:     He seemed to be having a great time! I think his job is stressing him out ... He needs nights like these to unwind.<br/><span class=\"strong\">Sally</span>:         For sure! If he asks you again, are you going to go?<br/><span class=\"strong\">Vanessa</span>:     I don't know if I should if I want to meet someone new. What do you think?"}, {"image": "engenn7le16ob10re2img01.jpg", "time": "38300", "id": 3, "text": "<span class=\"strong\">Sally</span>:         Hm, good point. Can you remind me where the club is? I'm thinking about blogging about it. Before I do, I'm going to do some research online.<br/><span class=\"strong\">Vanessa</span>:     It's on Garden Street, near Dance Freedom. Before you blog about it, I'll send you some pictures from tonight.<br/><span class=\"strong\">Sally</span>:         When I get them, I'll call you if I have any questions. <br/><span class=\"strong\">Vanessa</span>:     One thing I really liked about Shimmer is that they have a huge disco ball and an amazing laser show. There were also go-go dancers upstairs!"}], "audiosrc": "engenn7le16ob10re2aud01", "coverimg": "engenn7le16ob10re2img05.jpg"}, "type": "slideshow"}], "id": 1}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": " I can talk about feelings and impressions.", "type": "Learning Outcomes"}, {"content": " I can talk about connected events in the future using <span class=\"italic\">if</span>, <span class=\"italic\">when</span>, <span class=\"italic\">before</span> or <span class=\"italic\">after</span>. ", "type": "Learning Outcomes"}, {"content": "I can ask for clarification. ", "type": "Learning Outcomes"}, {"content": " What do you think about the club scene in your country?", "type": "Free Header Item"}, {"content": "If you don't like going to clubs, what do you like to do when you go out at night?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "There were go-go dancers!", "type": "free_type_text_area"}], "questions": [], "type": "WLC", "id": 0, "img_path": "", "stimuli_ids": [0]}, {"template_override": 1, "_data": [{"contents": [{"content": " Vanessa tells Sally all about Shimmer. Why did the bar <span class=\"tool-tip\" id=\"tip_1_0\">make great money</span>?", "type": "text"}], "type": "in